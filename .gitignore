# 依赖
node_modules/

# 构建产物
dist/
*.local

# 环境变量（.env.example 需要入库）
.env
.env.*
!.env.example

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
.env
# Trae 编辑器工作目录（本地计划与临时文件，不入库）
.trae/

# 日志
*.log

# 浏览器端到端测试产物
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Capacitor 原生工程（在装有 Android SDK 的机器上由 npx cap add android 生成）
# 不入库的原因：local.properties 会写入本机 SDK 绝对路径，assets/public 会重复拷入 dist 产物
android/
ios/
# 签名文件绝不入库
*.keystore
*.jks
local.properties
.gradle/
