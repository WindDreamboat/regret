# 连接配置默认值
#
# 除密钥外的项都可在 App 的「设置 → 连接」页覆盖：页面填了就以页面为准，留空则回退到这里。
# 因此打包出 APK 后，改模型 / 改代理地址不必重新构建。

# —— 代理侧（仅服务端读取；不要加 VITE_ 前缀，否则会被打进前端产物）——
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名需对照 DeepSeek 官方文档核实，见需求文档「待决项」。
DEEPSEEK_MODEL=deepseek-flash

# 代理允许的跨源来源白名单（逗号分隔）。打包成 App 后 WebView 来源是 https://localhost，
# 因此默认值即该来源；Web 部署请改成你的站点域名。留空则只有默认来源。
CHAT_ALLOWED_ORIGIN=https://localhost

# —— 前端默认值（可在设置页覆盖；都不是密钥，可以暴露给前端）——
# 对话提供方：
#   mock（默认，逐字回显）
#   direct（App 直连厂商接口，无需部署代理；Key 只能填在设置页，故这里给不出默认值）
#   deepseek（走自建代理，Key 可留在代理侧）
VITE_CHAT_PROVIDER=mock

# 接口地址的默认值，含义随提供方而变：
#   deepseek：自建代理地址。Web 部署与本地开发同源时留空即可（前端用相对路径 /api/chat）；
#             打包成 App 后 WebView 解析不了相对路径，需在设置页填真实代理 URL
#             （例如 https://your-proxy.example.com/api/chat）。
#   direct：厂商的完整接口地址（例如 https://api.deepseek.com/v1/chat/completions），
#             打包后同样不能留空。对应的 Key 必须在设置页填，不要写进这里。
VITE_CHAT_API_ENDPOINT=