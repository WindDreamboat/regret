# DeepSeek 配置
# 注意：这些变量仅服务端（代理）读取，不要加 VITE_ 前缀，否则会被打进前端产物。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名需对照 DeepSeek 官方文档核实，见需求文档「待决项」。
DEEPSEEK_MODEL=deepseek-flash

# 代理允许的跨源来源白名单（逗号分隔）。打包成 App 后 WebView 来源是 https://localhost，
# 因此默认值即该来源；Web 部署请改成你的站点域名。留空则只有默认来源。
CHAT_ALLOWED_ORIGIN=https://localhost

# 前端选择对话提供方：mock（默认，逐字回显）或 deepseek（走代理）。
# 这个变量不是密钥，可以暴露给前端。
VITE_CHAT_PROVIDER=mock

# 代理的绝对地址。Web 部署与本地开发同源时留空即可（前端用相对路径 /api/chat）；
# 打包成 App 时必须填真实代理 URL，例如 https://your-proxy.example.com/api/chat，
# 否则 WebView 会把 /api/chat 解析到本地不存在的地址。
# 这里只放地址，不是密钥，可以暴露给前端。
VITE_CHAT_API_ENDPOINT=
